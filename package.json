{
  "name": "openslate",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source video agent for planning, generating, and editing long-form video.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter './apps/*' dev",
    "build:packages": "pnpm --filter './packages/*' -r build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "check": "pnpm build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
