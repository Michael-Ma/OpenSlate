{
  "name": "openslate",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source video agent for planning, generating, and editing long-form video.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node apps/server/dist/index.js --serve-web",
    "studio": "node apps/server/dist/studio-cli.js",
    "installation": "node apps/server/dist/installation-cli.js",
    "dev": "pnpm build:packages && pnpm --parallel --filter './apps/*' dev",
    "build:packages": "pnpm --filter './packages/*' -r build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "check": "node scripts/test-toolchain.mjs && pnpm test && pnpm -r typecheck",
    "test": "pnpm build && node scripts/run-tests.mjs",
    "demo:headless": "pnpm build && node apps/server/dist/demo.js",
    "probe:runtime": "pnpm build:packages && node packages/director/dist/probe/cli.js",
    "probe:launcher": "pnpm build && node apps/server/test/launcher-smoke.mjs",
    "probe:workflow": "pnpm build && node apps/server/test/six-minute-workflow-smoke.mjs",
    "probe:toolchain": "pnpm build && node apps/server/dist/toolchain-probe.js",
    "setup:test-media": "node scripts/setup-test-media.mjs",
    "check:toolchain": "node scripts/test-toolchain.mjs",
    "check:browser": "pnpm build && node scripts/browser-check.mjs",
    "studio:fixture": "pnpm build && node scripts/storyboard-review.mjs --fixtures --port 3101",
    "skills:draft": "pnpm build:packages && node scripts/skills.mjs draft",
    "skills:release": "pnpm build:packages && node scripts/skills.mjs release",
    "skills:check": "pnpm build:packages && node scripts/skills.mjs check"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2"
  }
}
