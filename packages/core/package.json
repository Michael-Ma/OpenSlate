{
  "name": "@openslate/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./public": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@babel/parser": "8.0.5",
    "ajv": "8.20.0"
  }
}
