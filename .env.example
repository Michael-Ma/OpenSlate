# Copy this template to the ignored .env.local and fill it in locally.
# Viggle credentials stay on the local server. Never commit a populated file.
# A key alone does not enable generation or approve spending.
OPENSLATE_VIGGLE_API_KEY=

# OpenAI image, speech and transcription APIs use this separate server key.
OPENSLATE_OPENAI_API_KEY=
# Codex image generation uses the existing ChatGPT login, not either API key.
# Select the exact supported runtime executable; never copy auth tokens here.
OPENSLATE_CODEX_IMAGE_BINARY=
# Optional existing Codex home; defaults to ~/.codex.
OPENSLATE_CODEX_IMAGE_HOME=
# Execution remains off unless explicitly enabled and separately approved in-app.
OPENSLATE_ENABLE_CODEX_IMAGE_GENERATION=0
OPENSLATE_ENABLE_IMAGE_GENERATION=0
OPENSLATE_ENABLE_VIGGLE_H3_GENERATION=0
OPENSLATE_ENABLE_H3_GENERATION=0
OPENSLATE_ENABLE_SPEECH_GENERATION=0
OPENSLATE_ENABLE_TRANSCRIPTION=0
