# Create the ignored .env.live.local with ./start.sh --init-config, then fill it in locally.
# Viggle credentials stay on the local server. Never commit a populated file.
# Configured keys enable their API routes. Generate and review media from the scene controls.
OPENSLATE_VIGGLE_API_KEY=

# OpenAI image, speech and transcription APIs use this separate server key.
OPENSLATE_OPENAI_API_KEY=
# Optional direct MiniMax video API. Viggle users can leave this empty.
OPENSLATE_MINIMAX_API_KEY=
# Explicit provider output host allowlists, required when their real video route is enabled.
# Add only the host names documented by your provider; no scheme, path or wildcard.
OPENSLATE_VIGGLE_H3_DOWNLOAD_HOSTS=
OPENSLATE_H3_DOWNLOAD_HOSTS=
# Demo is the default catalog. For real models select one of examples/*provider-profiles.example.json.
OPENSLATE_PROVIDER_CONFIG=
# Private project, media and SQLite storage.
OPENSLATE_DATA_DIR=.openslate
# Codex image generation uses the existing ChatGPT login, not either API key.
# Select the exact supported runtime executable; never copy auth tokens here.
OPENSLATE_CODEX_IMAGE_BINARY=
# Optional existing Codex home; defaults to ~/.codex.
OPENSLATE_CODEX_IMAGE_HOME=
# Optional technical overrides: set a route to 0 to disable it deliberately.
# Leave these unset to use configured-key/runtime readiness; no separate usage approval is required.
# OPENSLATE_ENABLE_CODEX_IMAGE_GENERATION=0
# OPENSLATE_ENABLE_IMAGE_GENERATION=0
# OPENSLATE_ENABLE_VIGGLE_H3_GENERATION=0
# OPENSLATE_ENABLE_H3_GENERATION=0
# OPENSLATE_ENABLE_SPEECH_GENERATION=0
# OPENSLATE_ENABLE_TRANSCRIPTION=0
